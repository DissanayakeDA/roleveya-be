# Copy to .env and fill in. Never commit .env.

# "production" hides /api/docs and /api/openapi.json
APP_ENV=development
LOG_LEVEL=INFO

# Neon: paste the connection string exactly as Neon shows it (postgresql://...?sslmode=require)
DATABASE_URL=

# Cognito user pool (sign-in with email). The app client needs ALLOW_USER_PASSWORD_AUTH and
# ALLOW_REFRESH_TOKEN_AUTH. Leave the secret blank if the app client has none.
# Region is optional: it is derived from the pool id (us-east-1_AbC123 -> us-east-1).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=

# Cloudinary (Console -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=roleveya

# Cookies. COOKIE_SECURE must be true anywhere served over HTTPS; false is only for http://localhost.
# REFRESH_TOKEN_DAYS should match the app client's refresh token expiration.
COOKIE_SECURE=false
COOKIE_DOMAIN=
REFRESH_TOKEN_DAYS=30

# Only needed when the frontend is NOT served through the /api proxy (comma-separated origins).
CORS_ORIGINS=

MAX_CV_MB=5
MAX_POSTER_MB=5
